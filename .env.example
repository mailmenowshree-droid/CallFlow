# Server-only MongoDB Atlas connection URI. Never commit a real URI.
MONGODB_URI=
MONGODB_DB=callflow

# Generate a cryptographically random value of at least 32 characters.
SESSION_SECRET=

# One-time Manager setup endpoint. Remove both values after the first Manager is created.
CALLFLOW_BOOTSTRAP_TOKEN=
BOOTSTRAP_MANAGER_EMAIL=

# Optional local bootstrap script inputs.
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_MANAGER_NAME=CallFlow Manager
